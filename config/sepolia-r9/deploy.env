# Sepolia rehearsal r9 (main at 355a7a71), beside r6, r7 and r8: the public inputs of
# script/DeployCore.s.sol, the plain core of ADR 0010 (script/sepolia/deploy.ps1 loads them). No
# key, password or RPC credential belongs here; the RPC is a public endpoint and serves the
# simulation. r9 repeats r8 on the newer code, with the same Safe and holders. After the read-back
# the network grants roles to a Sepolia-only test contract, script/sepolia/SepoliaOpenGate.sol, so
# that any wallet can try the curated path (script/sepolia/open-gate.md).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
GENESIS_CONFIG=config/sepolia-r9/genesis.json
# keccak256("6529-works/sepolia/r9")
DEPLOY_NAMESPACE=0xc11fe03dd7c9449d6788365e4a3c56624ff3dbd32a839a89a2d829693691f31d
# The r5 network Safe (2-of-3, Safe 1.4.1), reused: it also receives the network fee and is the
# marketplace owner of Stream and Editions. It holds no key the platform holds.
NETWORK_FEE_RECIPIENT=0x54a769fe591c3F47CF83d30b69e576497CE34454
MARKETPLACE_OWNER=0x54a769fe591c3F47CF83d30b69e576497CE34454
# The testnet museum: a dedicated EOA the operator holds (keystore "museum-r5"), no role.
MUSEUM=0xB37A2a265044Ca0cB07839950D208D62B3944D25
VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
# The r5 subscription (r5's to r8's modules are consumers), owned by the deployer; after the
# broadcast the deployer adds r9's entropy module as a consumer (script/README.md, "Sepolia").
VRF_SUBSCRIPTION_ID=89333215533523544286942655033330382207138972885355549119019072655576170365979
VRF_KEY_HASH=0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae
VRF_NATIVE_PAYMENT=1
MANIFEST_PATH=config/sepolia-r9/manifest-epoch0.json
MANIFEST_URI=https://raw.githubusercontent.com/6529-Collections/6529-works/main/config/sepolia-r9/manifest-epoch0.json
# Testnet deviation: the 1/1 English auction runs 1 hour (its minimum) instead of 24 hours, so the
# flows finish in hours. Every other parameter is the launch default.
AUCTION_DURATION=3600
DEPLOYER=0x26A3f4505145b5E6164260cc868e50ddd9863697
