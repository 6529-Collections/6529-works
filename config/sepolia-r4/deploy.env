# Sepolia rehearsal r4: the public inputs of script/Deploy.s.sol (script/sepolia/deploy.ps1
# loads them). No key, password or RPC credential belongs here; the RPC is a public endpoint.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
GENESIS_CONFIG=config/sepolia-r4/genesis.json
# keccak256("6529-works/sepolia/r4")
DEPLOY_NAMESPACE=0x66e9a51efcbefa2ee1a042fcad80b1411f51ecf7f4235d6b5ca92e734a2d3495
# The hot admin Safe, as on r1 to r3.
NETWORK_FEE_RECIPIENT=0x2588A62384F41bB32412841ab774CD574b427bd5
# The platform key, as on r1 to r3 (the runbook recommends a separate account on mainnet).
MARKETPLACE_OWNER=0x0a69CdD0d8De0680779237aFF610C90b61B83b2D
# The testnet museum: a dedicated EOA the operator holds (keystore "museum-r4"), no role.
MUSEUM=0xd954e414a216Bc2D3d1fdc8C0e9b258ffDfDD840
VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
VRF_SUBSCRIPTION_ID=38903710378804317348705427001479286583650260158086313704334113777010605078141
VRF_KEY_HASH=0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae
VRF_NATIVE_PAYMENT=1
MANIFEST_PATH=config/sepolia-r4/manifest-epoch0.json
MANIFEST_URI=https://raw.githubusercontent.com/6529-Collections/6529-works/main/config/sepolia-r4/manifest-epoch0.json
# Testnet deviation: the 1/1 English auction runs 1 hour (the governed minimum) instead of
# mainnet's 24 hours, so the flows finish in hours. Every other parameter is the mainnet default.
AUCTION_DURATION=3600
DEPLOYER=0x26A3f4505145b5E6164260cc868e50ddd9863697
