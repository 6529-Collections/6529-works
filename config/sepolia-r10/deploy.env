# Sepolia rehearsal r10 (main after the rename to 6529 Stream and the pre-freeze cleanups), beside
# r6 to r9: the public inputs of script/DeployCore.s.sol, the plain core of ADR 0010
# (script/sepolia/deploy.ps1 loads them). No key, password or RPC credential belongs here; the RPC
# is a public endpoint and serves the simulation. r10 repeats r9 on the renamed code, with the same
# Safe, holders and settings. After the read-back the network grants roles to a Sepolia-only test
# contract, script/sepolia/SepoliaOpenGate.sol, so that any wallet can try the curated path
# (script/sepolia/open-gate.md).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
GENESIS_CONFIG=config/sepolia-r10/genesis.json
# keccak256("6529-stream/sepolia/r10")
DEPLOY_NAMESPACE=0x8a22955f02f0694d3328abe83c130e92610b9efcb32fa8b5c62e1907aebfdc40
# The r5 network Safe (2-of-3, Safe 1.4.1), reused: it also receives the network fee and is the
# marketplace owner of Stream and Editions. It holds no key the platform holds.
NETWORK_FEE_RECIPIENT=0x54a769fe591c3F47CF83d30b69e576497CE34454
MARKETPLACE_OWNER=0x54a769fe591c3F47CF83d30b69e576497CE34454
# The testnet museum: a dedicated EOA the operator holds (keystore "museum-r5"), no role.
MUSEUM=0xB37A2a265044Ca0cB07839950D208D62B3944D25
VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
# The r5 subscription (r5's to r9's modules are consumers), owned by the deployer; after the
# broadcast the deployer adds r10's entropy module as a consumer (script/README.md, "Sepolia").
VRF_SUBSCRIPTION_ID=89333215533523544286942655033330382207138972885355549119019072655576170365979
VRF_KEY_HASH=0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae
VRF_NATIVE_PAYMENT=1
MANIFEST_PATH=config/sepolia-r10/manifest-epoch0.json
MANIFEST_URI=https://raw.githubusercontent.com/6529-Collections/6529-stream/main/config/sepolia-r10/manifest-epoch0.json
# Testnet deviation: the 1/1 English auction runs 1 hour (its minimum) instead of 24 hours, so the
# flows finish in hours. Every other parameter is the launch default.
AUCTION_DURATION=3600
DEPLOYER=0x26A3f4505145b5E6164260cc868e50ddd9863697
