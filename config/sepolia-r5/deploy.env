# Sepolia rehearsal r5: the public inputs of script/Deploy.s.sol (script/sepolia/deploy.ps1
# loads them). No key, password or RPC credential belongs here; the RPC is a public endpoint.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
GENESIS_CONFIG=config/sepolia-r5/genesis.json
# keccak256("6529-works/sepolia/r5")
DEPLOY_NAMESPACE=0xd511fee3f2b7440896b706847087712ba33d1609ee87dc87cef06b4c6b3d54aa
# The network Safe (2-of-3, Safe 1.4.1) also receives the network fee and is Stream's marketplace
# owner: it exists, holds no key the platform holds, and needs no further account.
NETWORK_FEE_RECIPIENT=0x54a769fe591c3F47CF83d30b69e576497CE34454
MARKETPLACE_OWNER=0x54a769fe591c3F47CF83d30b69e576497CE34454
# The testnet museum: a dedicated EOA the operator holds (keystore "museum-r5"), no role.
MUSEUM=0xB37A2a265044Ca0cB07839950D208D62B3944D25
VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
# A dedicated subscription created for r5 on 22 November 2026, owned by the deployer and funded
# with 0.02 Sepolia ETH in native currency; the entropy module is its only consumer.
VRF_SUBSCRIPTION_ID=89333215533523544286942655033330382207138972885355549119019072655576170365979
VRF_KEY_HASH=0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae
VRF_NATIVE_PAYMENT=1
MANIFEST_PATH=config/sepolia-r5/manifest-epoch0.json
MANIFEST_URI=https://raw.githubusercontent.com/6529-Collections/6529-works/main/config/sepolia-r5/manifest-epoch0.json
# Testnet deviation: the 1/1 English auction runs 1 hour (the governed minimum) instead of
# mainnet's 24 hours, so the flows finish in hours. Every other parameter is the mainnet default.
AUCTION_DURATION=3600
DEPLOYER=0x26A3f4505145b5E6164260cc868e50ddd9863697
