{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:6529-works:schema:promise-card:v1",
  "title": "Promise card, version 1",
  "description": "The machine-readable promise card of a 6529 Stream work: what is fixed, what can still change, by whom and after what delay, and the residual risks, read at one block. Generated by clients from on-chain reads and documents; never written on chain. Rules: docs/spec/declarations-and-conventions.md (DCL-26 to DCL-29, DCL-33).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v", "at", "work", "artist", "record", "storage", "license", "sale", "dispute", "powers",
    "declarations", "conservationFloor", "displayChange", "custody", "changeable", "residualRisks",
    "statements"
  ],
  "properties": {
    "v": { "const": 1 },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "urn:6529-works:schema:common:v1#/$defs/shortText" },
        "version": { "$ref": "urn:6529-works:schema:common:v1#/$defs/shortText" }
      }
    },
    "at": {
      "description": "The block every on-chain read was made at.",
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "blockNumber", "blockHash", "timestamp"],
      "properties": {
        "chainId": { "$ref": "urn:6529-works:schema:common:v1#/$defs/chainId" },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "blockHash": { "$ref": "urn:6529-works:schema:common:v1#/$defs/bytes32" },
        "timestamp": { "$ref": "urn:6529-works:schema:common:v1#/$defs/unixTime" }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "tokenId", "owner", "kind", "itemHash", "contentHash", "artistId", "collectionId"],
      "properties": {
        "token": { "$ref": "urn:6529-works:schema:common:v1#/$defs/address" },
        "tokenId": { "$ref": "urn:6529-works:schema:common:v1#/$defs/uint256" },
        "owner": { "$ref": "urn:6529-works:schema:common:v1#/$defs/address" },
        "kind": { "enum": ["ORIGINAL", "EDITION_MASTER"] },
        "itemHash": { "$ref": "urn:6529-works:schema:common:v1#/$defs/bytes32" },
        "contentHash": { "$ref": "urn:6529-works:schema:common:v1#/$defs/bytes32" },
        "artistId": { "$ref": "urn:6529-works:schema:common:v1#/$defs/uint256" },
        "collectionId": { "$ref": "urn:6529-works:schema:common:v1#/$defs/uint256" }
      }
    },
    "artist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeAuthority", "restrained", "pendingChange", "resolver"],
      "properties": {
        "activeAuthority": { "$ref": "urn:6529-works:schema:common:v1#/$defs/address" },
        "restrained": { "type": "boolean" },
        "pendingChange": { "enum": ["NONE", "STANDARD", "CONTESTED", "ESTATE", "LOST_KEY"] },
        "resolver": {
          "description": "The statement log's artist resolver at the block.",
          "$ref": "urn:6529-works:schema:common:v1#/$defs/address"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["not_open", "open", "finalized"] },
        "version": { "type": "integer", "minimum": 0 },
        "stateHash": { "$ref": "urn:6529-works:schema:common:v1#/$defs/bytes32" },
        "renderer": { "$ref": "urn:6529-works:schema:common:v1#/$defs/address" },
        "rendererPinned": { "type": "boolean" }
      },
      "if": { "properties": { "status": { "enum": ["open", "finalized"] } } },
      "then": { "required": ["version", "stateHash", "renderer", "rendererPinned"] }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onChainComplete", "files"],
      "properties": {
        "onChainComplete": { "type": "boolean" },
        "files": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fileId", "role", "sha256", "mimeType", "complete", "locators", "preferredKind"],
            "properties": {
              "fileId": { "$ref": "urn:6529-works:schema:common:v1#/$defs/bytes32" },
              "role": { "enum": ["PRIMARY", "PREVIEW", "AUXILIARY"] },
              "sha256": { "$ref": "urn:6529-works:schema:common:v1#/$defs/bytes32" },
              "mimeType": { "type": "string", "maxLength": 64 },
              "complete": { "type": "boolean" },
              "locators": { "type": "integer", "minimum": 0, "maximum": 16 },
              "preferredKind": { "enum": ["NONE", "ARWEAVE", "IPFS", "ONCHAIN"] }
            }
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdxId", "cc0", "textFileId", "textOnChain"],
      "properties": {
        "spdxId": { "type": "string", "maxLength": 64 },
        "cc0": { "type": "boolean" },
        "textFileId": { "$ref": "urn:6529-works:schema:common:v1#/$defs/bytes32" },
        "textOnChain": { "type": "boolean" }
      }
    },
    "sale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["NONE", "SOLD", "UNBID", "FROZEN_OUT", "RESCUED"] },
        "currency": { "$ref": "urn:6529-works:schema:common:v1#/$defs/address" },
        "price": { "$ref": "urn:6529-works:schema:common:v1#/$defs/uint256" },
        "edition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["editionId", "copies", "pricePerCopy"],
          "properties": {
            "editionId": { "$ref": "urn:6529-works:schema:common:v1#/$defs/uint256" },
            "copies": { "$ref": "urn:6529-works:schema:common:v1#/$defs/uint256" },
            "pricePerCopy": { "$ref": "urn:6529-works:schema:common:v1#/$defs/uint256" }
          }
        }
      },
      "if": { "properties": { "outcome": { "const": "SOLD" } } },
      "then": { "required": ["currency", "price"] }
    },
    "dispute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryHash", "scope"],
      "properties": {
        "entryHash": {
          "description": "latestDisputeOutcome(token, tokenId), or null for zero.",
          "oneOf": [{ "$ref": "urn:6529-works:schema:common:v1#/$defs/bytes32" }, { "type": "null" }]
        },
        "scope": { "enum": ["token", "item", null] },
        "documentVerified": { "type": "boolean" }
      }
    },
    "powers": {
      "description": "Which work powers are renounced, read from WorkRecords' IWorkPowers.renouncedPowers (ADR 0006, DCL-8); available is false where the deployment's WorkRecords does not report IWorkPowers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "renounced": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:6529-works:schema:common:v1#/$defs/powerName" }
        },
        "retained": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:6529-works:schema:common:v1#/$defs/powerName" }
        }
      },
      "if": { "properties": { "available": { "const": true } } },
      "then": { "required": ["renounced", "retained"] }
    },
    "declarations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["absent", "valid", "invalid", "ambiguous", "unreadable"] },
        "fileId": { "$ref": "urn:6529-works:schema:common:v1#/$defs/bytes32" },
        "timeCapsule": { "type": "boolean" },
        "livingWork": { "type": "boolean" },
        "intendedRenunciations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["power", "dueAt", "state"],
            "properties": {
              "power": { "$ref": "urn:6529-works:schema:common:v1#/$defs/powerName" },
              "dueAt": { "$ref": "urn:6529-works:schema:common:v1#/$defs/unixTime" },
              "state": { "enum": ["renounced", "pending", "overdue", "unknown"] }
            }
          }
        }
      }
    },
    "conservationFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "format", "license", "generative", "display"],
      "properties": {
        "storage": { "$ref": "#/$defs/floorState" },
        "format": { "$ref": "#/$defs/floorState" },
        "license": { "$ref": "#/$defs/floorState" },
        "generative": { "$ref": "#/$defs/floorState" },
        "display": { "$ref": "#/$defs/floorState" }
      }
    },
    "displayChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["none", "accepted"] },
        "proposal": { "$ref": "urn:6529-works:schema:common:v1#/$defs/bytes32" },
        "acceptance": { "$ref": "urn:6529-works:schema:common:v1#/$defs/bytes32" },
        "contentSha256": { "$ref": "urn:6529-works:schema:common:v1#/$defs/bytes32" },
        "acceptedBy": { "$ref": "urn:6529-works:schema:common:v1#/$defs/address" },
        "acceptedByCurrentOwner": { "type": "boolean" }
      },
      "if": { "properties": { "state": { "const": "accepted" } } },
      "then": { "required": ["proposal", "acceptance", "contentSha256", "acceptedBy", "acceptedByCurrentOwner"] }
    },
    "custody": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objectId", "custodian", "recognized", "status", "stale"],
        "properties": {
          "objectId": { "$ref": "urn:6529-works:schema:common:v1#/$defs/bytes32" },
          "custodian": { "$ref": "urn:6529-works:schema:common:v1#/$defs/address" },
          "recognized": {
            "description": "Named by the declarations document, or reached from a named custodian by RELEASED attestations (DCL-22).",
            "type": "boolean"
          },
          "status": { "enum": ["HELD", "RELEASED", "MISSING", "DESTROYED", "NONE"] },
          "asOf": { "$ref": "urn:6529-works:schema:common:v1#/$defs/unixTime" },
          "stale": { "type": "boolean" }
        },
        "if": { "properties": { "status": { "const": "NONE" } } },
        "then": {
          "description": "A named custodian with no valid attestation (DCL-21): no date, and stale.",
          "not": { "required": ["asOf"] },
          "properties": { "recognized": { "const": true }, "stale": { "const": true } }
        },
        "else": { "required": ["asOf"] }
      }
    },
    "changeable": {
      "description": "Who can still change what, after what delay: from the role matrix at the block and the work's own state (DCL-27).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["what", "who", "delaySeconds", "guardianCancel", "until"],
        "properties": {
          "what": {
            "enum": [
              "record", "license", "royalty_rate", "renderer", "served_copy", "dispute_statement",
              "artist_authority", "artist_resolver", "burn_and_release"
            ]
          },
          "who": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z_]{1,31}$" }
          },
          "delaySeconds": { "type": "integer", "minimum": 0 },
          "guardianCancel": { "type": "boolean" },
          "until": { "enum": ["finalize", "settlement", "renounced", "permanent"] },
          "renouncedBy": { "$ref": "urn:6529-works:schema:common:v1#/$defs/powerName" }
        }
      }
    },
    "residualRisks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^LIM-[A-Z]{2,4}-[0-9]{1,3}$" }
    },
    "statements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "head"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "head": { "$ref": "urn:6529-works:schema:common:v1#/$defs/bytes32" }
      }
    }
  },
  "$defs": {
    "floorState": { "enum": ["met", "waived", "unmet", "not_applicable"] }
  }
}
