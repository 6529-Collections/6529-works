pragma solidity ^0.8.24;

import { Base64 } from "@openzeppelin/contracts/utils/Base64.sol";
import { ContentBase } from "../ContentBase.sol";
import { UploaderGoldenData as Golden } from "./UploaderGoldenData.sol";
import { ContentStore } from "src/content/ContentStore.sol";
import { IContentStore } from "src/interfaces/IContentStore.sol";

/// @dev Cross-language agreement between the Python uploader (`tools/content`) and the real
///      `ContentStore`. The vectors in `UploaderGoldenData` are generated by the Python tooling
///      from `tools/content/golden/vectors.json`; every assertion here makes Solidity reproduce a
///      value Python computed: chunk hashes, the file ID, the SHA-256 of the media, the ABI
///      calldata of `registerManifest` and `writeChunk`, and the base64 text. A change to either
///      side that breaks agreement fails here (and in `tools/content/test_golden.py`).
///
///      Solidity cannot gzip, so the gzip vectors are checked from their committed stored bytes
///      (small ones) or from their hashes and file ID (large ones), never re-encoded here.
contract UploaderGoldenTest is ContentBase {
    function setUp() public {
        store = new ContentStore();
    }

    // ------------------------------------------------------------------ helpers

    function _enc(uint8 value) internal pure returns (IContentStore.Encoding) {
        return IContentStore.Encoding(value);
    }

    /// @dev Everything about a vector that needs only its stored bytes: Solidity's own chunking,
    ///      hashing, file ID and calldata must equal what Python wrote down.
    function _assertAgrees(Golden.Vector memory v, bytes memory stored) internal view {
        assertEq(stored.length, v.storedLength, v.name);
        (bytes[] memory chunks, bytes32[] memory hashes) = _split(stored);
        assertEq(hashes.length, v.chunkHashes.length, v.name);
        for (uint256 i; i < hashes.length; ++i) {
            assertEq(hashes[i], v.chunkHashes[i], v.name);
        }
        assertEq(
            store.manifestId(hashes, stored.length, _enc(v.encoding), v.mimeType, v.mediaSha256),
            v.fileId,
            v.name
        );
        assertEq(
            abi.encodeCall(
                store.registerManifest,
                (hashes, stored.length, _enc(v.encoding), v.mimeType, v.mediaSha256)
            ),
            v.registerCalldata,
            v.name
        );
        if (v.writeCalldata.length != 0) {
            assertEq(v.writeCalldata.length, chunks.length, v.name);
            for (uint256 i; i < chunks.length; ++i) {
                assertEq(abi.encodeCall(store.writeChunk, (chunks[i])), v.writeCalldata[i], v.name);
            }
        }
    }

    /// @dev Sends the Python-built `registerManifest` calldata, then every chunk, and checks the
    ///      store ends up complete with exactly the declared fields and bytes.
    function _assertStages(Golden.Vector memory v, bytes memory stored) internal {
        (bool ok, bytes memory ret) = address(store).call(v.registerCalldata);
        assertTrue(ok, "registerManifest calldata reverted");
        assertEq(abi.decode(ret, (bytes32)), v.fileId, v.name);
        assertFalse(store.isComplete(v.fileId), "complete before any chunk");
        assertEq(store.missingChunks(v.fileId).length, v.chunkHashes.length, v.name);

        (bytes[] memory chunks, bytes32[] memory hashes) = _split(stored);
        for (uint256 i; i < chunks.length; ++i) {
            bytes memory callData = v.writeCalldata.length != 0
                ? v.writeCalldata[i]
                : abi.encodeCall(store.writeChunk, (chunks[i]));
            (ok, ret) = address(store).call(callData);
            assertTrue(ok, "writeChunk calldata reverted");
            (bytes32 hash,) = abi.decode(ret, (bytes32, address));
            assertEq(hash, hashes[i], v.name);
        }

        assertTrue(store.isComplete(v.fileId), v.name);
        assertEq(store.read(v.fileId, 0, stored.length), stored, v.name);
        IContentStore.FileInfo memory info = store.fileInfo(v.fileId);
        assertEq(info.sha256Hash, v.mediaSha256, v.name);
        assertEq(info.length, v.storedLength, v.name);
        assertEq(info.chunkCount, v.chunkHashes.length, v.name);
        assertEq(uint8(info.encoding), v.encoding, v.name);
        assertEq(info.mimeType, v.mimeType, v.name);
    }

    /// @dev The stored stream of a generated vector: the media itself, or its base64 text.
    function _generatedStored(Golden.Vector memory v)
        internal
        pure
        returns (bytes memory media, bytes memory stored)
    {
        media = _data(v.mediaLength, v.seed);
        stored = v.encoding == uint8(IContentStore.Encoding.Base64)
            ? bytes(Base64.encode(media))
            : media;
    }

    // ------------------------------------------------------------------ small samples

    /// @dev One sample per encoding. Solidity hashes the committed media and, for the two
    ///      encodings it can reproduce, derives the stored bytes itself.
    function test_Inline_DigestsAndStoredBytesMatch() public pure {
        Golden.Vector[] memory vectors = Golden.samples();
        for (uint256 i; i < vectors.length; ++i) {
            Golden.Vector memory v = vectors[i];
            assertEq(sha256(v.media), v.mediaSha256, v.name);
            assertEq(v.media.length, v.mediaLength, v.name);
            if (v.encoding == uint8(IContentStore.Encoding.Identity)) {
                assertEq(v.stored, v.media, v.name);
            } else if (v.encoding == uint8(IContentStore.Encoding.Base64)) {
                assertEq(v.stored, bytes(Base64.encode(v.media)), v.name);
            }
        }
    }

    function test_Inline_ChunkHashesFileIdAndCalldataMatch() public view {
        Golden.Vector[] memory vectors = Golden.samples();
        for (uint256 i; i < vectors.length; ++i) {
            _assertAgrees(vectors[i], vectors[i].stored);
        }
    }

    function test_Inline_PythonCalldataStagesTheFile() public {
        Golden.Vector[] memory vectors = Golden.samples();
        for (uint256 i; i < vectors.length; ++i) {
            _assertStages(vectors[i], vectors[i].stored);
        }
    }

    // ------------------------------------------------------------------ large, generated

    /// @dev Layout edges and multi-chunk identity and base64 files, rebuilt here from the seed.
    function test_Generated_ChunkingFileIdAndCalldataMatch() public view {
        Golden.Vector[] memory vectors = Golden.generated();
        for (uint256 i; i < vectors.length; ++i) {
            (bytes memory media, bytes memory stored) = _generatedStored(vectors[i]);
            assertEq(sha256(media), vectors[i].mediaSha256, vectors[i].name);
            _assertAgrees(vectors[i], stored);
        }
    }

    function test_Generated_PythonCalldataStagesTheFile() public {
        Golden.Vector[] memory vectors = Golden.generated();
        for (uint256 i; i < vectors.length; ++i) {
            (, bytes memory stored) = _generatedStored(vectors[i]);
            _assertStages(vectors[i], stored);
        }
    }

    /// @dev The layout rule at its edges, spelled out (not only through the hashes): a full
    ///      chunk is one chunk, one byte more is a second chunk holding one byte.
    function test_Generated_EdgeChunkCounts() public pure {
        Golden.Vector[] memory vectors = Golden.generated();
        assertEq(vectors[0].chunkHashes.length, 1, "exact one chunk");
        assertEq(vectors[1].chunkHashes.length, 2, "one chunk plus one byte");
        assertEq(vectors[2].chunkHashes.length, 2, "exact two chunks");
        assertEq(vectors[3].chunkHashes.length, 3, "60,000 bytes");
        (bytes[] memory chunks,) = _split(_data(vectors[1].mediaLength, vectors[1].seed));
        assertEq(chunks[0].length, CHUNK);
        assertEq(chunks[1].length, 1);
    }

    // ------------------------------------------------------------------ large gzip: hashes only

    function test_HashOnly_FileIdAndRegistrationMatch() public {
        Golden.Vector[] memory vectors = Golden.hashOnly();
        for (uint256 i; i < vectors.length; ++i) {
            Golden.Vector memory v = vectors[i];
            assertEq(
                store.manifestId(
                    v.chunkHashes, v.storedLength, _enc(v.encoding), v.mimeType, v.mediaSha256
                ),
                v.fileId,
                v.name
            );
            assertEq(
                abi.encodeCall(
                    store.registerManifest,
                    (v.chunkHashes, v.storedLength, _enc(v.encoding), v.mimeType, v.mediaSha256)
                ),
                v.registerCalldata,
                v.name
            );
            (bool ok, bytes memory ret) = address(store).call(v.registerCalldata);
            assertTrue(ok, "registerManifest calldata reverted");
            assertEq(abi.decode(ret, (bytes32)), v.fileId, v.name);
            assertEq(store.missingChunks(v.fileId).length, v.chunkHashes.length, v.name);
        }
    }

    // ------------------------------------------------------------------ gas model

    function _modelWriteChunk(uint256 length) internal pure returns (uint256) {
        return Golden.GAS_WRITE_CHUNK_BASE + Golden.GAS_WRITE_CHUNK_PER_BYTE * length;
    }

    function _modelRegister(uint256 chunkCount, uint256 mimeLength)
        internal
        pure
        returns (uint256)
    {
        return Golden.GAS_REGISTER_BASE + Golden.GAS_REGISTER_PER_CHUNK * chunkCount
            + Golden.GAS_REGISTER_PER_MIME_BYTE * mimeLength
            + (mimeLength > 31 ? Golden.GAS_REGISTER_LONG_MIME : 0);
    }

    /// @dev A MIME type of exactly `length` bytes, `a/b` padded with `x`.
    function _mime(uint256 length) internal pure returns (string memory) {
        bytes memory out = new bytes(length);
        for (uint256 i; i < length; ++i) {
            out[i] = "x";
        }
        out[0] = "a";
        out[1] = "/";
        return string(out);
    }

    /// @dev The Python gas model is an upper bound for a new chunk. Each fuzz run starts from the
    ///      state after `setUp`, so every measured call is cold, as in a fresh transaction.
    function testFuzz_GasModel_WriteChunkNeverExceedsTheModel(uint256 length, uint256 seed) public {
        length = bound(length, 1, CHUNK);
        bytes memory callData = abi.encodeCall(store.writeChunk, (_data(length, seed)));
        uint256 used = _gasOf(callData);
        assertLe(used, _modelWriteChunk(length), "writeChunk gas above the Python model");
        assertLe(
            21_000 + _calldataGas(callData) + used, Golden.TX_GAS_CAP, "transaction above the cap"
        );
    }

    function testFuzz_GasModel_RegisterManifestNeverExceedsTheModel(
        uint256 chunkCount,
        uint256 mimeLength,
        uint256 seed
    ) public {
        chunkCount = bound(chunkCount, 1, store.MAX_CHUNKS());
        mimeLength = bound(mimeLength, 3, store.MAX_MIME_LENGTH());
        bytes32[] memory hashes = new bytes32[](chunkCount);
        for (uint256 i; i < chunkCount; ++i) {
            hashes[i] = keccak256(abi.encode(seed, i));
        }
        bytes memory callData = abi.encodeCall(
            store.registerManifest,
            (
                hashes,
                (chunkCount - 1) * CHUNK + 1,
                IContentStore.Encoding(bound(seed, 0, 3)),
                _mime(mimeLength),
                DIGEST
            )
        );
        uint256 used = _gasOf(callData);
        assertLe(
            used, _modelRegister(chunkCount, mimeLength), "registerManifest gas above the model"
        );
        assertLe(
            21_000 + _calldataGas(callData) + used, Golden.TX_GAS_CAP, "transaction above the cap"
        );
    }

    /// @dev The worst bounded inputs, modelled, stay inside the Fusaka cap with the quarter of
    ///      the cap the repository keeps in reserve.
    function test_GasModel_WorstCasesFitTheCapWithMargin() public view {
        uint256 maxChunks = store.MAX_CHUNKS();
        // Calldata of the largest registration: the head and a full hash list, all nonzero bytes.
        uint256 registerCalldata = 4 + 32 * (5 + 2 + maxChunks) + 64;
        uint256 registerTx = 21_000 + _modelRegister(maxChunks, 64) + 16 * registerCalldata;
        assertLe(registerTx, Golden.TX_GAS_CAP * 3 / 4, "register at the limit lacks margin");

        uint256 writeCalldata = 4 + 64 + CHUNK + 31;
        uint256 writeTx = 21_000 + _modelWriteChunk(CHUNK) + 16 * writeCalldata;
        assertLe(writeTx, Golden.TX_GAS_CAP * 3 / 4, "a chunk write lacks margin");
    }
}
